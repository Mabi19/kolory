   "source": [
    "def gamma(r):\n",
    "    if r <= 0.04045:\n",
    "        return r / 12.92\n",
    "    else:\n",
    "        return ((r + 0.055) / 1.055) ** 2.4\n",
    "\n",
    "plot(gamma, xmin=0, xmax=1, axes_labels=[\"$R'$\", \"$R$\"])"
   ]
  }
